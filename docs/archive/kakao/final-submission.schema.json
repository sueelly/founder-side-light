{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "quote": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "quote"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "InsightDocument": {
      "additionalProperties": false,
      "properties": {
        "markdown": {
          "maxLength": 100000,
          "minLength": 1,
          "title": "Markdown",
          "type": "string"
        }
      },
      "required": [
        "markdown"
      ],
      "title": "InsightDocument",
      "type": "object"
    },
    "InterviewSummary": {
      "additionalProperties": false,
      "properties": {
        "number": {
          "maximum": 4,
          "minimum": 1,
          "title": "Number",
          "type": "integer"
        },
        "candidate_id": {
          "minLength": 1,
          "title": "Candidate Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "mode": {
          "enum": [
            "human",
            "agent"
          ],
          "title": "Mode",
          "type": "string"
        },
        "started_at": {
          "minimum": 0,
          "title": "Started At",
          "type": "number"
        },
        "closed_at": {
          "minimum": 0,
          "title": "Closed At",
          "type": "number"
        },
        "limit_seconds": {
          "enum": [
            1200,
            1800
          ],
          "title": "Limit Seconds",
          "type": "integer"
        },
        "insight_action": {
          "enum": [
            "updated",
            "unchanged"
          ],
          "title": "Insight Action",
          "type": "string"
        },
        "insights_before_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Insights Before Sha256",
          "type": "string"
        },
        "insights_after_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Insights After Sha256",
          "type": "string"
        },
        "transcript_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Transcript Sha256",
          "type": "string"
        },
        "feedback_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Feedback Sha256",
          "type": "string"
        },
        "protocol_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Protocol Note"
        }
      },
      "required": [
        "number",
        "candidate_id",
        "name",
        "mode",
        "started_at",
        "closed_at",
        "limit_seconds",
        "insight_action",
        "insights_before_sha256",
        "insights_after_sha256",
        "transcript_sha256",
        "feedback_sha256",
        "protocol_note"
      ],
      "title": "InterviewSummary",
      "type": "object"
    },
    "RankedCandidate": {
      "additionalProperties": false,
      "properties": {
        "rank": {
          "maximum": 4,
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "candidate_id": {
          "minLength": 1,
          "title": "Candidate Id",
          "type": "string"
        },
        "rationale": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "maxItems": 40,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "uncertainty": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Uncertainty",
          "type": "string"
        }
      },
      "required": [
        "rank",
        "candidate_id",
        "rationale",
        "evidence",
        "uncertainty"
      ],
      "title": "RankedCandidate",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "founder-light-1",
      "title": "Schema Version",
      "type": "string"
    },
    "session_id": {
      "minLength": 1,
      "title": "Session Id",
      "type": "string"
    },
    "submission_id": {
      "minLength": 1,
      "title": "Submission Id",
      "type": "string"
    },
    "insights": {
      "$ref": "#/$defs/InsightDocument"
    },
    "interviews": {
      "items": {
        "$ref": "#/$defs/InterviewSummary"
      },
      "maxItems": 4,
      "minItems": 4,
      "title": "Interviews",
      "type": "array"
    },
    "ranking": {
      "items": {
        "$ref": "#/$defs/RankedCandidate"
      },
      "maxItems": 4,
      "minItems": 4,
      "title": "Ranking",
      "type": "array"
    },
    "payload_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Payload Sha256",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "session_id",
    "submission_id",
    "insights",
    "interviews",
    "ranking",
    "payload_sha256"
  ],
  "title": "FinalSubmission",
  "type": "object"
}
